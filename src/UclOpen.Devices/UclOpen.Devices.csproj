<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>A package providing common hardware and control functionality for all UCL Open experiments.</Description>
    <PackageTags>$(PackageTags) Devices</PackageTags>
    <TargetFrameworks>net472</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="**\*.bonsai" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bonsai.Arduino"   Version="2.9.0" />
    <PackageReference Include="Bonsai.Core"      Version="2.9.0" />
    <PackageReference Include="Bonsai.Spinnaker" Version="0.9.1" />
    <PackageReference Include="Harp.Behavior" Version="0.2.0" />
    <PackageReference Include="Harp.TimestampGeneratorGen3" Version="0.1.1" />
    <PackageReference Include="AllenNeuralDynamics.LicketySplit" Version="0.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UclOpen.Core\UclOpen.Core.csproj" />
    <PackageReference Include="Harp.Hobgoblin" Version="0.1.2" />
  </ItemGroup>

</Project>
