<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:p1="clr-namespace:UclOpen.Tests;assembly=UclOpen.Tests"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:wie="clr-namespace:Bonsai.Windows.Input;assembly=Bonsai.Windows.Input"
                 xmlns:cv="clr-namespace:Bonsai.Vision;assembly=Bonsai.Vision"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="SubjectId" />
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="SessionId" />
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="Path" />
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Logging:LogController.bonsai">
        <SubjectId>DataMouse</SubjectId>
        <SessionId>001</SessionId>
        <Path>C:\temp_data</Path>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:BehaviorDeviceSimulator">
          <p1:Period />
          <p1:Seed>0</p1:Seed>
          <p1:MessageType>Event</p1:MessageType>
          <p1:SequencePayload>false</p1:SequencePayload>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>BehaviorEvents</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>BehaviorEvents</Name>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Logging:LogHarpDevice.bonsai">
        <LogName>HarpDevice</LogName>
        <ChunkSize>0.01</ChunkSize>
        <ClosingDuration xsi:nil="true" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="wie:MouseMove" />
      </Expression>
      <Expression xsi:type="InputMapping">
        <PropertyMappings>
          <Property Name="X" Selector="X" />
          <Property Name="Y" Selector="Y" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="cv:CreatePoint3d">
          <cv:X>341</cv:X>
          <cv:Y>86</cv:Y>
          <cv:Z>0</cv:Z>
        </Combinator>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="Bonsai.Harp:WithLatestTimestamp.bonsai">
        <Name>BehaviorEvents</Name>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Logging:LogData.bonsai">
        <ChunkSize>0.01</ChunkSize>
        <ClosingDuration xsi:nil="true" />
        <LogName>MouseMove</LogName>
        <Selector>Seconds, Value.X, Value.Y, Value.Z</Selector>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="3" Label="Source1" />
      <Edge From="1" To="3" Label="Source2" />
      <Edge From="2" To="3" Label="Source3" />
      <Edge From="4" To="5" Label="Source1" />
      <Edge From="6" To="7" Label="Source1" />
      <Edge From="8" To="9" Label="Source1" />
      <Edge From="9" To="10" Label="Source1" />
      <Edge From="10" To="11" Label="Source1" />
      <Edge From="11" To="12" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>