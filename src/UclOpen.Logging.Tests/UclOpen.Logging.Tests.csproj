<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472</TargetFrameworks>
    <!-- Pulls in the native OpenCV binaries used to generate and inspect test videos -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- Test workflows are launched from disk by the Bonsai CLI rather than embedded -->
  <ItemGroup>
    <None Update="**\*.bonsai" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.8.3" />
    <PackageReference Include="MSTest.TestFramework" Version="3.8.3" />
    <!-- Matches the version in the Bonsai environment, since the output directory is also its lib path -->
    <PackageReference Include="OpenCV.Net" Version="3.4.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UclOpen.Logging\UclOpen.Logging.csproj" />
    <ProjectReference Include="..\UclOpen.Tests\UclOpen.Tests.csproj" />
  </ItemGroup>

</Project>
