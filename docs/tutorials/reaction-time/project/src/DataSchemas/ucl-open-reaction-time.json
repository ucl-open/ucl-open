{
  "$defs": {
    "DisplayCalibration": {
      "properties": {
        "intrinsics": {
          "$ref": "#/$defs/DisplayIntrinsics",
          "default": {
            "frameWidth": 1920,
            "frameHeight": 1080,
            "displayWidth": 20.0,
            "displayHeight": 15.0
          },
          "description": "Intrinsics",
          "title": "Intrinsics"
        },
        "extrinsics": {
          "$ref": "#/$defs/DisplayExtrinsics",
          "default": {
            "rotation": {
              "x": 0.0,
              "y": 0.0,
              "z": 0.0
            },
            "translation": {
              "x": 0.0,
              "y": 0.0,
              "z": 0.0
            }
          },
          "description": "Extrinsics",
          "title": "Extrinsics"
        }
      },
      "title": "DisplayCalibration",
      "type": "object"
    },
    "DisplayExtrinsics": {
      "properties": {
        "rotation": {
          "$ref": "#/$defs/Vector3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          },
          "description": "Euler rotation vector (radians)",
          "title": "Rotation"
        },
        "translation": {
          "$ref": "#/$defs/Vector3",
          "default": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          },
          "description": "Translation vector",
          "title": "Translation"
        }
      },
      "title": "DisplayExtrinsics",
      "type": "object"
    },
    "DisplayIntrinsics": {
      "properties": {
        "frameWidth": {
          "default": 1920,
          "description": "Pixel frame width",
          "minimum": 0,
          "title": "FrameWidth",
          "type": "integer"
        },
        "frameHeight": {
          "default": 1080,
          "description": "Pixel frame height",
          "minimum": 0,
          "title": "FrameHeight",
          "type": "integer"
        },
        "displayWidth": {
          "default": 20,
          "description": "Physical display width",
          "minimum": 0,
          "title": "DisplayWidth",
          "type": "number"
        },
        "displayHeight": {
          "default": 15,
          "description": "Physical display height",
          "minimum": 0,
          "title": "DisplayHeight",
          "type": "number"
        }
      },
      "title": "DisplayIntrinsics",
      "type": "object"
    },
    "ExperimentSession": {
      "description": "The base class for creating ucl-open experiment models.",
      "properties": {
        "workflow": {
          "description": "Path to the workflow running the experiment.",
          "title": "Workflow",
          "type": "string"
        },
        "commit": {
          "description": "Commit hash of the experiment repo.",
          "title": "Commit",
          "type": "string"
        },
        "repositoryUrl": {
          "description": "The URL of the git repository used to version experiment source code.",
          "title": "RepositoryUrl",
          "type": "string"
        },
        "subjectId": {
          "description": "The subject id for this session.",
          "title": "SubjectId",
          "type": "string"
        },
        "sessionId": {
          "description": "The session identifier.",
          "title": "SessionId",
          "type": "string"
        }
      },
      "required": [
        "workflow",
        "commit",
        "repositoryUrl",
        "subjectId",
        "sessionId"
      ],
      "title": "ExperimentSession",
      "type": "object"
    },
    "HarpHobgoblin": {
      "properties": {
        "portName": {
          "description": "The name of the device serial port.",
          "examples": [
            "COM"
          ],
          "title": "PortName",
          "type": "string"
        }
      },
      "required": [
        "portName"
      ],
      "title": "HarpHobgoblin",
      "type": "object"
    },
    "Screen": {
      "properties": {
        "displayIndex": {
          "default": 1,
          "description": "Display index",
          "title": "DisplayIndex",
          "type": "integer"
        },
        "targetRenderFrequency": {
          "default": 60,
          "description": "Target render frequency",
          "title": "TargetRenderFrequency",
          "type": "number"
        },
        "targetUpdateFrequency": {
          "default": 120,
          "description": "Target update frequency",
          "title": "TargetUpdateFrequency",
          "type": "number"
        },
        "textureAssetsDirectory": {
          "default": "Textures",
          "description": "Calibration directory",
          "title": "TextureAssetsDirectory",
          "type": "string"
        },
        "calibration": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/DisplayCalibration"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Calibration parameters for a set of named display monitors for visual stimuli",
          "title": "Calibration"
        },
        "brightness": {
          "default": 0,
          "description": "Brightness",
          "maximum": 1,
          "minimum": -1,
          "title": "Brightness",
          "type": "number"
        },
        "contrast": {
          "default": 1,
          "description": "Contrast",
          "maximum": 1,
          "minimum": -1,
          "title": "Contrast",
          "type": "number"
        }
      },
      "title": "Screen",
      "type": "object"
    },
    "Trial": {
      "properties": {
        "temporalFrequency": {
          "description": "Temporal frequency of the gratings in this stimulus",
          "minimum": 0,
          "title": "TemporalFrequency",
          "type": "number"
        },
        "targetDelay": {
          "description": "Target response time (seconds) delay for the subject after this stimulus is presented",
          "minimum": 0,
          "title": "TargetDelay",
          "type": "number"
        }
      },
      "required": [
        "temporalFrequency",
        "targetDelay"
      ],
      "title": "Trial",
      "type": "object"
    },
    "UclOpenReactionTimeRig": {
      "properties": {
        "rootPath": {
          "description": "The root path on which to log all data.",
          "title": "RootPath",
          "type": "string"
        },
        "version": {
          "const": "0.0.0-rc1",
          "default": "0.0.0-rc1",
          "title": "Version",
          "type": "string"
        },
        "harpHobgoblin": {
          "$ref": "#/$defs/HarpHobgoblin",
          "description": "Harp Hobgoblin device"
        },
        "screen": {
          "$ref": "#/$defs/Screen",
          "description": "The main display for visual stimuli"
        }
      },
      "required": [
        "rootPath",
        "harpHobgoblin",
        "screen"
      ],
      "title": "UclOpenReactionTimeRig",
      "type": "object"
    },
    "UclOpenReactionTimeTaskLogic": {
      "properties": {
        "version": {
          "const": "0.0.0-rc1",
          "default": "0.0.0-rc1",
          "title": "Version",
          "type": "string"
        },
        "name": {
          "const": "UclOpenReactionTime",
          "default": "UclOpenReactionTime",
          "description": "Name of the task logic",
          "title": "Name",
          "type": "string"
        },
        "taskParameters": {
          "$ref": "#/$defs/UclOpenReactionTimeTaskParameters",
          "description": "Parameters of the task logic",
          "title": "TaskParameters"
        }
      },
      "required": [
        "taskParameters"
      ],
      "title": "UclOpenReactionTimeTaskLogic",
      "type": "object"
    },
    "UclOpenReactionTimeTaskParameters": {
      "properties": {
        "trials": {
          "description": "The sequence of trials that will be delivered in the experiment",
          "items": {
            "$ref": "#/$defs/Trial"
          },
          "title": "Trials",
          "type": "array"
        },
        "maxTrialTime": {
          "description": "The maximum amount of time (seconds) allowed for a response in any trial. Exceeding this time should result in the trial aborting and moving to the next trial in the sequence",
          "title": "MaxTrialTime",
          "type": "number"
        },
        "initialDelayTime": {
          "description": "Time (in seconds) between initiation of a new trial and onset of presentation of the trial stimulus",
          "title": "InitialDelayTime",
          "type": "number"
        },
        "rngSeed": {
          "default": null,
          "description": "Seed of the random number generator for these task parameters",
          "title": "RngSeed",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "trials",
        "maxTrialTime",
        "initialDelayTime"
      ],
      "title": "UclOpenReactionTimeTaskParameters",
      "type": "object"
    },
    "Vector3": {
      "properties": {
        "x": {
          "description": "X coordinate of the point.",
          "title": "X",
          "type": "number"
        },
        "y": {
          "description": "Y coordinate of the point.",
          "title": "Y",
          "type": "number"
        },
        "z": {
          "description": "Z coordinate of the point.",
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "title": "Vector3",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/UclOpenReactionTimeTaskLogic"
    },
    {
      "$ref": "#/$defs/UclOpenReactionTimeRig"
    },
    {
      "$ref": "#/$defs/ExperimentSession"
    }
  ],
  "title": "RootModel[Union[UclOpenReactionTimeTaskLogic, UclOpenReactionTimeRig, ExperimentSession]]"
}