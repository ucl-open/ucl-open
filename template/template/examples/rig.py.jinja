from pathlib import Path

from ucl_open.core import yaml

from {{ python_folder_name }}.rig import (
    {{ python_class_prefix }}Rig
)

TEMPLATE_PATH = Path("config/rig-template.yml")
SCHEMA_PATH = "../src/DataSchemas/{{ python_folder_name }}.json#/$defs/{{ python_class_prefix }}Rig"
HEADER = """\
# Rig configuration template, generated by examples/rig.py. Do not edit by hand.
# scripts/deploy.ps1 copies it to <ConfigRoot>\\<MACHINE-NAME>\\rig.yml when that file does not
# exist yet; fill in the copy there. Per-rig values are never committed.
"""

# Placeholder values only: they must look wrong until a rig fills them in.
rig = {{ python_class_prefix }}Rig(
    root_path="C:\\Data\\CHANGE-ME",
)


def main(path: Path = TEMPLATE_PATH):
    path.parent.mkdir(parents=True, exist_ok=True)
    yaml.save(rig, path, schema_path=SCHEMA_PATH)
    directive, body = path.read_text(encoding="utf-8").split("\n", 1)
    path.write_text(directive + "\n" + HEADER + body, encoding="utf-8")
    print(f"Rig configuration template written to {path}")


if __name__ == "__main__":
    main()
